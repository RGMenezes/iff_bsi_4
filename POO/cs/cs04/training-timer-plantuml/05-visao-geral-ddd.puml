@startuml TrainingTimerModel
' Training Timer IFF — Visão geral de dependências DDD
' Mantém o mesmo fluxo lógico do Mermaid original.

title Visão Geral — Fluxo de Dependências (DDD)

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam dpi 160
skinparam nodesep 55
skinparam ranksep 70
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1
skinparam ArrowFontColor #222222
skinparam rectangleBackgroundColor white
skinparam rectangleBorderColor #333333
skinparam packageStyle rectangle
skinparam packageBorderColor #333333
skinparam packageFontName Arial
skinparam packageFontStyle bold
skinparam titleFontName Arial
skinparam titleFontSize 18
skinparam titleFontStyle bold

left to right direction

package "infrastructure/web" as WEB #FFF3CD {
    rectangle "Handlers\nAuthHandler · UserHandler\nWorkoutSheetHandler · etc." as H
    rectangle "Router" as R
    rectangle "Main\nJavalin + JWT middleware" as M

    H -[hidden]-> R
    R -[hidden]-> M
}

package "application" as APP #CCE5FF {
    rectangle "Services\nAuthService · UserService\nWorkoutSheetService · etc." as S
    rectangle "Observer\nSessionCompletedListener\nGoalAutoChecker" as OBS
    rectangle "Ports\nXxxRepositoryPort" as P

    S -[hidden]-> OBS
    OBS -[hidden]-> P
}

package "infrastructure/persistence" as INFRA #F8D7DA {
    rectangle "Repositories\nUserRepository · WorkoutSheetRepository · etc." as REPO
    rectangle "BaseRepository\ninterface com default methods" as BASE

    REPO -[hidden]-> BASE
}

package "model" as MODEL #D4EDDA {
    rectangle "Entities\nUser · WorkoutSheet · Goal · etc." as ENT
    rectangle "Domain Exceptions\nNotFoundException · ForbiddenException · etc." as EX

    ENT -[hidden]-> EX
}

' Relações originais do fluxo
WEB --> APP : chama
APP --> P : usa ports
REPO --> P : implementa
REPO --> BASE : implementa
APP --> MODEL
P --> MODEL
INFRA --> MODEL

@enduml

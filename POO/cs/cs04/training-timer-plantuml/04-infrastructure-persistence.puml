@startuml TrainingTimerModel
' Training Timer IFF — INFRASTRUCTURE / Persistence
' Estilo inspirado no visual UML clássico do Astah.

title INFRASTRUCTURE — Persistence

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam dpi 160
skinparam nodesep 50
skinparam ranksep 65
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontName Arial
skinparam classAttributeFontName Arial
skinparam classAttributeFontColor #111111
skinparam classStereotypeFontName Arial
skinparam classStereotypeFontStyle italic
skinparam classAttributeIconSize 0
skinparam classBorderThickness 1
skinparam titleFontName Arial
skinparam titleFontSize 18
skinparam titleFontStyle bold

left to right direction

class BaseRepository <<interface>> {
    +insertAndReturn(JdbcTemplate, String, Object[]) : long
}

class UserRepository {
    -jdbc : JdbcTemplate
}
class WorkoutSheetRepository {
    -jdbc : JdbcTemplate
}
class WorkoutBlockRepository {
    -jdbc : JdbcTemplate
}
class ExerciseSetRepository {
    -jdbc : JdbcTemplate
}
class SheetAssignmentRepository {
    -jdbc : JdbcTemplate
}
class WorkoutSessionRepository {
    -jdbc : JdbcTemplate
}
class GoalRepository {
    -jdbc : JdbcTemplate
}

class UserRepositoryPort <<interface>>
class WorkoutSheetRepositoryPort <<interface>>
class WorkoutBlockRepositoryPort <<interface>>
class ExerciseSetRepositoryPort <<interface>>
class SheetAssignmentRepositoryPort <<interface>>
class WorkoutSessionRepositoryPort <<interface>>
class GoalRepositoryPort <<interface>>

' Relações originais
UserRepository ..|> BaseRepository
UserRepository ..|> UserRepositoryPort
WorkoutSheetRepository ..|> BaseRepository
WorkoutSheetRepository ..|> WorkoutSheetRepositoryPort
WorkoutBlockRepository ..|> BaseRepository
WorkoutBlockRepository ..|> WorkoutBlockRepositoryPort
ExerciseSetRepository ..|> BaseRepository
ExerciseSetRepository ..|> ExerciseSetRepositoryPort
SheetAssignmentRepository ..|> BaseRepository
SheetAssignmentRepository ..|> SheetAssignmentRepositoryPort
WorkoutSessionRepository ..|> BaseRepository
WorkoutSessionRepository ..|> WorkoutSessionRepositoryPort
GoalRepository ..|> BaseRepository
GoalRepository ..|> GoalRepositoryPort

' Ligações invisíveis: estabilizam a ordem visual.
UserRepository -[hidden]-> WorkoutSheetRepository
WorkoutSheetRepository -[hidden]-> WorkoutBlockRepository
WorkoutBlockRepository -[hidden]-> ExerciseSetRepository
ExerciseSetRepository -[hidden]-> SheetAssignmentRepository
SheetAssignmentRepository -[hidden]-> WorkoutSessionRepository
WorkoutSessionRepository -[hidden]-> GoalRepository

UserRepositoryPort -[hidden]-> WorkoutSheetRepositoryPort
WorkoutSheetRepositoryPort -[hidden]-> WorkoutBlockRepositoryPort
WorkoutBlockRepositoryPort -[hidden]-> ExerciseSetRepositoryPort
ExerciseSetRepositoryPort -[hidden]-> SheetAssignmentRepositoryPort
SheetAssignmentRepositoryPort -[hidden]-> WorkoutSessionRepositoryPort
WorkoutSessionRepositoryPort -[hidden]-> GoalRepositoryPort

@enduml

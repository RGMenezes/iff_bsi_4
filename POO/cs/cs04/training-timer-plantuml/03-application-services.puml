@startuml TrainingTimerModel
' Training Timer IFF — APPLICATION / Services
' Estilo inspirado no visual UML clássico do Astah.

title APPLICATION — Services

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam dpi 160
skinparam nodesep 45
skinparam ranksep 60
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1
skinparam ArrowFontColor #222222
skinparam ArrowFontName Arial
skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classFontColor #111111
skinparam classFontName Arial
skinparam classAttributeFontName Arial
skinparam classAttributeFontColor #111111
skinparam classStereotypeFontName Arial
skinparam classStereotypeFontStyle italic
skinparam classAttributeIconSize 0
skinparam classBorderThickness 1
skinparam titleFontName Arial
skinparam titleFontSize 18
skinparam titleFontStyle bold

left to right direction

class JwtUtil {
    -key : SecretKey
    -expirationMs : long
    --
    +generate(Long, String, String) : String
    +parse(String) : Claims
}

class AuthService {
    -userRepository : UserRepositoryPort
    -jwtUtil : JwtUtil
    --
    +login(LoginRequest) : LoginResponse
}

class UserService {
    -userRepository : UserRepositoryPort
    --
    +createUser(CreateUserRequest) : UserResponse
    +listStudents() : List<UserResponse>
    +getStudent(Long) : UserResponse
    +updateStudent(Long, UpdateUserRequest) : UserResponse
    +deactivateStudent(Long)
    +me(Long) : UserResponse
}

class WorkoutSheetService {
    -sheetRepository : WorkoutSheetRepositoryPort
    -blockRepository : WorkoutBlockRepositoryPort
    -setRepository : ExerciseSetRepositoryPort
    --
    +create(CreateSheetRequest, Long) : WorkoutSheetSummary
    +listByProfessor(Long) : List<WorkoutSheetSummary>
    +getById(Long, Long) : WorkoutSheetDetail
    +getByIdForStudent(Long) : WorkoutSheetDetail
    +update(Long, UpdateSheetRequest, Long) : WorkoutSheetSummary
    +deactivate(Long, Long)
    +duplicate(Long, Long) : WorkoutSheetSummary
}

class WorkoutBlockService {
    -blockRepository : WorkoutBlockRepositoryPort
    -sheetRepository : WorkoutSheetRepositoryPort
    -setRepository : ExerciseSetRepositoryPort
    --
    +addBlock(Long, CreateBlockRequest, Long) : WorkoutBlockResponse
    +updateBlock(Long, Long, UpdateBlockRequest, Long) : WorkoutBlockResponse
    +deleteBlock(Long, Long, Long)
}

class ExerciseSetService {
    -setRepository : ExerciseSetRepositoryPort
    -blockRepository : WorkoutBlockRepositoryPort
    -sheetRepository : WorkoutSheetRepositoryPort
    --
    +addSet(Long, Long, CreateSetRequest, Long) : ExerciseSetResponse
    +updateSet(Long, Long, Long, UpdateSetRequest, Long) : ExerciseSetResponse
    +deleteSet(Long, Long, Long, Long)
}

class SheetAssignmentService {
    -assignmentRepository : SheetAssignmentRepositoryPort
    -userRepository : UserRepositoryPort
    -sheetRepository : WorkoutSheetRepositoryPort
    --
    +assign(CreateAssignmentRequest) : AssignmentResponse
    +listByStudent(Long) : List<AssignmentResponse>
    +activeForStudent(Long) : List<AssignmentResponse>
    +remove(Long)
}

class GoalService {
    -goalRepository : GoalRepositoryPort
    -userRepository : UserRepositoryPort
    -sheetRepository : WorkoutSheetRepositoryPort
    --
    +create(CreateGoalRequest, Long) : GoalResponse
    +listByStudent(Long) : List<GoalResponse>
    +myGoals(Long) : List<GoalResponse>
    +markReached(Long) : GoalResponse
}

class SessionCompletedListener <<interface>> {
    +onSessionCompleted(Long studentId, Long assignmentId)
}

class GoalAutoChecker {
    -goalRepository : GoalRepositoryPort
    -assignmentRepository : SheetAssignmentRepositoryPort
    --
    +onSessionCompleted(Long, Long)
}

class WorkoutSessionService {
    -sessionRepository : WorkoutSessionRepositoryPort
    -assignmentRepository : SheetAssignmentRepositoryPort
    -sheetRepository : WorkoutSheetRepositoryPort
    -listeners : List<SessionCompletedListener>
    --
    +record(CreateSessionRequest, Long) : SessionResponse
    +myHistory(Long) : List<SessionResponse>
    +studentHistory(Long, DateTime, DateTime, Long) : List<SessionResponse>
}

' Ports referenciados neste diagrama. Sem membros aqui para manter o foco nos Services.
class UserRepositoryPort <<interface>>
class WorkoutSheetRepositoryPort <<interface>>
class WorkoutBlockRepositoryPort <<interface>>
class ExerciseSetRepositoryPort <<interface>>
class SheetAssignmentRepositoryPort <<interface>>
class WorkoutSessionRepositoryPort <<interface>>
class GoalRepositoryPort <<interface>>

' Relações originais
GoalAutoChecker ..|> SessionCompletedListener : implements
WorkoutSessionService o-- SessionCompletedListener : notifica (Observer)
AuthService --> JwtUtil
AuthService --> UserRepositoryPort
UserService --> UserRepositoryPort
WorkoutSheetService --> WorkoutSheetRepositoryPort
WorkoutSheetService --> WorkoutBlockRepositoryPort
WorkoutSheetService --> ExerciseSetRepositoryPort
WorkoutBlockService --> WorkoutBlockRepositoryPort
WorkoutBlockService --> WorkoutSheetRepositoryPort
WorkoutBlockService --> ExerciseSetRepositoryPort
ExerciseSetService --> ExerciseSetRepositoryPort
ExerciseSetService --> WorkoutBlockRepositoryPort
ExerciseSetService --> WorkoutSheetRepositoryPort
SheetAssignmentService --> SheetAssignmentRepositoryPort
SheetAssignmentService --> UserRepositoryPort
SheetAssignmentService --> WorkoutSheetRepositoryPort
GoalService --> GoalRepositoryPort
GoalService --> UserRepositoryPort
GoalService --> WorkoutSheetRepositoryPort
WorkoutSessionService --> WorkoutSessionRepositoryPort
WorkoutSessionService --> SheetAssignmentRepositoryPort
WorkoutSessionService --> WorkoutSheetRepositoryPort
GoalAutoChecker --> GoalRepositoryPort
GoalAutoChecker --> SheetAssignmentRepositoryPort

' Ligações invisíveis: organizam os services e ports sem alterar o modelo.
AuthService -[hidden]-> UserService
UserService -[hidden]-> WorkoutSheetService
WorkoutSheetService -[hidden]-> WorkoutBlockService
WorkoutBlockService -[hidden]-> ExerciseSetService
ExerciseSetService -[hidden]-> SheetAssignmentService
SheetAssignmentService -[hidden]-> GoalService
GoalService -[hidden]-> WorkoutSessionService

UserRepositoryPort -[hidden]-> WorkoutSheetRepositoryPort
WorkoutSheetRepositoryPort -[hidden]-> WorkoutBlockRepositoryPort
WorkoutBlockRepositoryPort -[hidden]-> ExerciseSetRepositoryPort
ExerciseSetRepositoryPort -[hidden]-> SheetAssignmentRepositoryPort
SheetAssignmentRepositoryPort -[hidden]-> WorkoutSessionRepositoryPort
WorkoutSessionRepositoryPort -[hidden]-> GoalRepositoryPort

@enduml
